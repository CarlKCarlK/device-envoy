#![allow(missing_docs)]
//! MAX98357A sample playback example using {{ chip_name }} I2S.
//!
//! Wiring:
//! - Data pin (`DIN`) -> GPIO{{ data_pin }}
//! - Bit clock pin (`BCLK`) -> GPIO{{ bit_clock_pin }}
//! - Word select pin (`LRC` / `LRCLK`) -> GPIO{{ word_select_pin }}
//! - Button -> GPIO{{ button_pin }} to GND (starts playback)

#![no_std]
#![no_main]

use core::convert::Infallible;
use core::time::Duration as StdDuration;

use embassy_executor::Spawner;
use embassy_time::{Duration, Timer};
use esp_backtrace as _;
use log::info;

use device_envoy_esp::{init_and_start, Result};
use device_envoy_esp::{
    audio_player::{
        audio_player, pcm_clip, AtEnd, AudioPlayer, Gain, SilenceClip, Volume, VOICE_22050_HZ,
    },
    button::{Button as _, ButtonEsp, PressedTo},
    tone,
};

esp_bootloader_esp_idf::esp_app_desc!();

audio_player! {
    AudioPlayerBoard {
        data_pin: GPIO{{ data_pin }},
        bit_clock_pin: GPIO{{ bit_clock_pin }},
        word_select_pin: GPIO{{ word_select_pin }},
        sample_rate_hz: VOICE_22050_HZ,
        dma: {{ dma_identifier }},
        max_volume: Volume::percent(50),
        initial_volume: Volume::percent(100),
    }
}

pcm_clip! {
    Nasa {
        file: concat!(env!("CARGO_MANIFEST_DIR"), "/examples/data/audio/nasa_22k.s16"),
        source_sample_rate_hz: VOICE_22050_HZ,
    }
}

#[esp_rtos::main]
async fn main(spawner: Spawner) -> ! {
    let err = inner_main(spawner).await.unwrap_err();
    panic!("{err:?}");
}

async fn inner_main(spawner: Spawner) -> Result<Infallible> {
    init_and_start!(p);
    esp_println::logger::init_logger(log::LevelFilter::Info);

    const NASA: &AudioPlayerBoardPlayable = &Nasa::pcm_clip().with_gain(Gain::percent(25));
    const TONE_A4: &AudioPlayerBoardPlayable = &tone!(
        440,
        AudioPlayerBoard::SAMPLE_RATE_HZ,
        StdDuration::from_millis(500)
    )
    .with_gain(Gain::percent(25));
    const SILENCE_100MS: &AudioPlayerBoardPlayable =
        &SilenceClip::new(StdDuration::from_millis(100));

    let mut button = ButtonEsp::new(p.GPIO{{ button_pin }}, PressedTo::Ground);

    let audio_player_board =
        AudioPlayerBoard::new(
            p.GPIO{{ data_pin }},
            p.GPIO{{ bit_clock_pin }},
            p.GPIO{{ word_select_pin }},
            p.I2S0,
            p.{{ dma_identifier }},
            spawner,
        )?;

    info!(
        "I2S ready: GPIO{{ data_pin }} DIN, GPIO{{ bit_clock_pin }} BCLK, GPIO{{ word_select_pin }} LRCLK"
    );
    info!(
        "Loaded sample: {} samples ({} bytes), 22.05kHz mono s16le",
        Nasa::PCM_SAMPLE_COUNT,
        Nasa::PCM_SAMPLE_COUNT * 2
    );
    info!("Button on GPIO{{ button_pin }} starts playback");

    loop {
        button.wait_for_press().await;
        audio_player_board.play([TONE_A4, SILENCE_100MS, TONE_A4], AtEnd::Loop);
        info!("Started static slice playback");
        for percent in [80, 60, 40, 20, 200] {
            audio_player_board.set_volume(Volume::percent(percent));
            info!("Runtime volume set to {}%", percent);
            Timer::after(Duration::from_secs(1)).await;
        }
        audio_player_board.stop();
        Timer::after(Duration::from_secs(1)).await;
        audio_player_board.set_volume(
            <AudioPlayerBoard as AudioPlayer<{ AudioPlayerBoard::SAMPLE_RATE_HZ }>>::INITIAL_VOLUME,
        );
        audio_player_board.play([NASA], AtEnd::Stop);
    }
}
