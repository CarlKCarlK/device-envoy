{# @board-example #}
//! Wiring:
//! - I2C LCD SDA -> GPIO{{ lcd_sda_pin }}
//! - I2C LCD SCL -> GPIO{{ lcd_scl_pin }}
//!
#![allow(missing_docs)]
#![no_std]
#![no_main]

use core::convert::Infallible;

use embassy_executor::Spawner;
use embassy_time::{Duration, Timer};
use esp_backtrace as _;

use device_envoy_esp::{i2cs, init_and_start, lcd_text::LcdText as _, Result};

esp_bootloader_esp_idf::esp_app_desc!();

i2cs! {
    i2c: I2C0,
    sda_pin: GPIO{{ lcd_sda_pin }},
    scl_pin: GPIO{{ lcd_scl_pin }},
    I2cs0 {
        LcdText16x2 { width: 16, height: 2, address: 0x27 },
        LcdText20x4 { width: 20, height: 4, address: 0x26 },
    }
}

#[esp_rtos::main]
async fn main(spawner: Spawner) -> ! {
    let err = inner_main(spawner).await.unwrap_err();
    panic!("{err:?}");
}

async fn inner_main(spawner: Spawner) -> Result<Infallible> {
    init_and_start!(p);

    let (lcd_text16x2, lcd_text20x4) = I2cs0::new(
        p.I2C0,
        p.GPIO{{ lcd_sda_pin }},
        p.GPIO{{ lcd_scl_pin }},
        spawner,
    )?;

    loop {
        lcd_text16x2.write_text("LCD #1\n16x2");
        lcd_text20x4.write_text("LCD #2\n20x4\nshared i2c\naddress 0x3F");
        Timer::after(Duration::from_secs(1)).await;

        lcd_text16x2.write_text("Tick");
        lcd_text20x4.write_text("Tock");
        Timer::after(Duration::from_secs(1)).await;
    }
}
