{# @board-example min_spi=2 #}
// @generated by cargo xtask generate-board-examples
//! Draws a tiled, labeled grid across the full 320x240 CYD panel using a
//! small, tile-sized draw buffer rather than a full-screen one.
//!
{%- if chip_feature == "esp32" %}
//! Wiring: the classic CYD board's built-in ILI9341 display, fixed at the
//! factory (see `device_envoy_esp::cyd` module docs for the CYD abstraction):
{%- else %}
//! Wiring: a standalone 320x240 ILI9341 + XPT2046 module wired to spare
//! SPI-capable GPIOs (see `device_envoy_esp::cyd` module docs for the CYD
//! abstraction):
{%- endif %}
//!
//! - Display SPI SCK  -> GPIO{{ cyd_display_sck_pin }}
//! - Display SPI MOSI -> GPIO{{ cyd_display_mosi_pin }}
//! - Display SPI MISO -> GPIO{{ cyd_display_miso_pin }}
//! - Display CS       -> GPIO{{ cyd_display_cs_pin }}
//! - Display DC       -> GPIO{{ cyd_display_dc_pin }}
//! - Display RST      -> GPIO{{ cyd_display_rst_pin }}
//! - Display backlight -> GPIO{{ cyd_display_backlight_pin }}
//! - Plus 3.3V and GND
#![no_std]
#![no_main]

use core::{convert::Infallible, fmt::Write};

use embassy_executor::Spawner;
use embassy_time::{Duration, Timer};
use esp_backtrace as _;
use log::info;

use device_envoy_esp::{
    Result, init_and_start,
    cyd::{
        CydDevice as _, CydDisplayTrait as _, CydEsp, CydStaticEsp, DEFAULT_FONT, Orientation,
        tiling::TileGrid,
    },
};

esp_bootloader_esp_idf::esp_app_desc!();

const TILE_COLUMNS: usize = 4;
const TILE_ROWS: usize = 4;
const TILE_WIDTH: usize = 320 / TILE_COLUMNS;
const TILE_HEIGHT: usize = 240 / TILE_ROWS;
const TILE_PIXEL_COUNT: usize = TILE_WIDTH * TILE_HEIGHT;

#[esp_rtos::main]
async fn main(spawner: Spawner) -> ! {
    let err = inner_main(spawner).await.unwrap_err();
    panic!("{err:?}");
}

async fn inner_main(_spawner: Spawner) -> Result<Infallible> {
    init_and_start!(p);
    esp_println::logger::init_logger(log::LevelFilter::Info);
    info!("Starting CYD tiles demo");

    static CYD_STATIC: CydStaticEsp<TILE_PIXEL_COUNT> = CydEsp::new_static();
    let mut cyd = CydEsp::new_display_only(
        &CYD_STATIC,
        p.SPI2,
        p.GPIO{{ cyd_display_sck_pin }},
        p.GPIO{{ cyd_display_mosi_pin }},
        p.GPIO{{ cyd_display_miso_pin }},
        p.GPIO{{ cyd_display_cs_pin }},
        p.GPIO{{ cyd_display_dc_pin }},
        p.GPIO{{ cyd_display_rst_pin }},
        p.GPIO{{ cyd_display_backlight_pin }},
        Orientation::Landscape,
        embedded_graphics::pixelcolor::Rgb888::new(10, 10, 12),
        embedded_graphics::pixelcolor::Rgb888::new(230, 230, 230),
        &DEFAULT_FONT,
    )?;
    info!("CYD display initialized");

    let palette = [
        embedded_graphics::pixelcolor::Rgb565::new(6, 20, 10),
        embedded_graphics::pixelcolor::Rgb565::new(2, 10, 25),
    ];

    let grid = TileGrid::new(
        embedded_graphics::geometry::Point::zero(),
        embedded_graphics::geometry::Size::new(320, 240),
        TILE_COLUMNS,
        TILE_ROWS,
    );

    loop {
        let (mut display, _touch) = cyd.parts();
        let mut tiles = display.tiles(grid);
        let mut tile_index: usize = 0;
        while let Some(mut frame) = tiles.next() {
            frame.fill(palette[tile_index % palette.len()]);
            let mut label = heapless::String::<8>::new();
            let _ = write!(label, "{tile_index}");
            frame.write_text(label.as_str());
            frame.flush()?;
            tile_index += 1;
        }
        Timer::after(Duration::from_secs(1)).await;
    }
}
