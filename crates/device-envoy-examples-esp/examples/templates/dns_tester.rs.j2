{# @board-example wifi min_spi=2 large_stack #}
// @generated by cargo xtask generate-board-examples
//! Touch-triggered Wi-Fi/DNS reliability tester.
//!
//! Tap anywhere on the panel to fire one DNS query and update a running tally
//! of hits/misses and the last round-trip latency on a single status line.
//! Meant to run for hours unattended on hardware with no reachable physical
//! reset button, repeatedly exercising the touch driver and the Wi-Fi stack
//! together so long-run failures (socket exhaustion, dropped connections,
//! stuck touch reads) show up on screen instead of silently wedging the
//! board. The status line stays deliberately small: a full-screen frame
//! buffer plus the Wi-Fi stack's own heap overflows plain ESP32's DRAM.
//!
{%- if chip_feature == "esp32" %}
//! Wiring: the classic CYD board's built-in ILI9341 display and XPT2046
//! touch controller, fixed at the factory (see `device_envoy_esp::cyd`
//! module docs for the CYD abstraction):
{%- else %}
//! Wiring: a standalone 320x240 ILI9341 + XPT2046 module wired to spare
//! SPI-capable GPIOs (see `device_envoy_esp::cyd` module docs for the CYD
//! abstraction):
{%- endif %}
//!
//! - Display SPI SCK  -> GPIO{{ cyd_display_sck_pin }}
//! - Display SPI MOSI -> GPIO{{ cyd_display_mosi_pin }}
//! - Display SPI MISO -> GPIO{{ cyd_display_miso_pin }}
//! - Display CS       -> GPIO{{ cyd_display_cs_pin }}
//! - Display DC       -> GPIO{{ cyd_display_dc_pin }}
//! - Display RST      -> GPIO{{ cyd_display_rst_pin }}
//! - Display backlight -> GPIO{{ cyd_display_backlight_pin }}
//! - Touch SPI SCK    -> GPIO{{ cyd_touch_sck_pin }}
//! - Touch SPI MOSI   -> GPIO{{ cyd_touch_mosi_pin }}
//! - Touch SPI MISO   -> GPIO{{ cyd_touch_miso_pin }}
//! - Touch CS         -> GPIO{{ cyd_touch_cs_pin }}
//! - Touch IRQ        -> GPIO{{ cyd_touch_irq_pin }}
//! - Button (Wi-Fi reset while connecting; calibration backup afterward) -> GPIO{{ button_pin }}
//!   to GND (`PressedTo::Ground`)
//! - Plus 3.3V and GND
#![no_std]
#![no_main]

use core::convert::Infallible;

use embassy_executor::Spawner;
use embassy_net::dns::DnsQueryType;
use embassy_time::Instant;
use embedded_graphics::pixelcolor::Rgb888;
use derive_more::From;
use esp_hal::system::software_reset;
use esp_backtrace as _;
use log::{info, warn};

use device_envoy_core::cyd::display::Orientation;
use device_envoy_core::dns::{DnsResult, DnsRuntime};
use device_envoy_examples_core::dns_tester::{
    self as dns_tester, Error as CoreError, Exit as CoreExit,
};
use device_envoy_core::flash_block::FlashBlock as _;
use device_envoy_esp::{
    Error, init_and_start,
    button::PressedTo,
    button_watch,
    cyd::{
        CydError, CydEsp, CydStaticEsp,
        DEFAULT_DISPLAY_SPI_HZ, DEFAULT_FONT,
    },
    flash_block::FlashBlockEsp,
    wifi_auto::{WifiAuto as _, WifiAutoEsp},
};

esp_bootloader_esp_idf::esp_app_desc!();

button_watch! {
    ButtonWatch {
        pin: GPIO{{ button_pin }},
    }
}

#[esp_rtos::main]
async fn main(spawner: Spawner) -> ! {
    let err = inner_main(spawner).await.unwrap_err();
    panic!("{err:?}");
}

async fn inner_main(spawner: Spawner) -> core::result::Result<Infallible, MainError> {
    init_and_start!(p);
    esp_println::logger::init_logger(log::LevelFilter::Info);
    info!("Starting CYD DNS tester on {{ chip_name }} / {{ board_slug }}");
    // configuration or are required by the compile-time display storage.
    let [wifi_auto_flash_block, mut calibration_flash_block, mut orientation_flash_block] =
        FlashBlockEsp::new_array::<3>(p.FLASH)?;
    let orientation = orientation_flash_block
        .load::<Orientation>()?
        .unwrap_or(Orientation::Landscape);

    static CYD_STATIC: CydStaticEsp<{ dns_tester::FRAME_PIXEL_COUNT }> =
        CydEsp::new_static();
    let mut button = ButtonWatch::new(p.GPIO{{ button_pin }}, PressedTo::Ground, spawner).await?;
    let mut cyd = CydEsp::new(
        &CYD_STATIC, // statics
        p.SPI2, // display_spi
        p.GPIO{{ cyd_display_sck_pin }}, // display_sck_pin
        p.GPIO{{ cyd_display_mosi_pin }}, // display_mosi_pin
        p.GPIO{{ cyd_display_miso_pin }}, // display_miso_pin
        p.GPIO{{ cyd_display_cs_pin }}, // display_cs_pin
        p.GPIO{{ cyd_display_dc_pin }}, // display_dc_pin
        p.GPIO{{ cyd_display_rst_pin }}, // display_rst_pin
        p.GPIO{{ cyd_display_backlight_pin }}, // display_backlight_pin
        DEFAULT_DISPLAY_SPI_HZ, // display_spi_hz
        orientation, // orientation
        Rgb888::new(10, 10, 12), // background: near-black
        Rgb888::new(230, 230, 230), // foreground: near-white
        &DEFAULT_FONT, // font
        p.SPI3, // touch_spi
        p.GPIO{{ cyd_touch_sck_pin }}, // touch_sck_pin
        p.GPIO{{ cyd_touch_mosi_pin }}, // touch_mosi_pin
        p.GPIO{{ cyd_touch_miso_pin }}, // touch_miso_pin
        p.GPIO{{ cyd_touch_cs_pin }}, // touch_cs_pin
        p.GPIO{{ cyd_touch_irq_pin }}, // touch_irq_pin
        &mut calibration_flash_block,
        &mut *button,
    )
    .await?;
    info!("CYD display and touch initialized and calibrated");
    dns_tester::splash(&mut cyd).await?;

    let wifi_auto = WifiAutoEsp::new(
        p.WIFI,
        wifi_auto_flash_block,
        "DnsTesterSetup",
        [],
        spawner,
    )?;

    let stack = wifi_auto
        .connect(&mut *button, async |wifi_auto_event| -> core::result::Result<(), MainError> {
            dns_tester::wifi_status(&mut cyd, wifi_auto_event).await?;
            info!("Wi-Fi: {wifi_auto_event:?}");
            Ok(())
        })
        .await?;

    info!("Wi-Fi up with DHCP: {:?}", stack.config_v4());

    // TODO000 [addressed] is this nice? Keep the platform-specific DNS query
    // closure here so it can measure the real network latency.
    // TODO000 why listed twice?
    const DNS_HOSTNAME: &str = "example.com";
    let mut dns = DnsRuntime::new(DNS_HOSTNAME, async || {
        let query_start = Instant::now();
        let dns_result = stack.dns_query(DNS_HOSTNAME, DnsQueryType::A).await;
        let latency_millis = query_start.elapsed().as_millis();
        let succeeded = match dns_result {
            Ok(addresses) if !addresses.is_empty() => {
                info!("DNS ok in {latency_millis}ms: {:?}", addresses.first());
                true
            }
            Ok(_) => {
                warn!("DNS query returned no addresses");
                false
            }
            Err(_) => {
                warn!("DNS query failed");
                false
            }
        };
        Ok::<DnsResult, Infallible>(DnsResult {
            succeeded,
            latency_millis,
        })
    });
    match dns_tester::run(&mut cyd, &mut *button, &mut dns).await? {
        CoreExit::Calibrate => {
            calibration_flash_block.clear()?;
        }
        CoreExit::ResetWifi => {
            wifi_auto.reset_to_captive_portal()?;
        }
        CoreExit::Reorientate(next_orientation) => {
            orientation_flash_block.save(&next_orientation)?;
        }
    }
    software_reset();
}

#[derive(Debug, From)]
enum MainError {
    Platform(Error),
    DnsTester(CoreError<CydError, Infallible>),
}
