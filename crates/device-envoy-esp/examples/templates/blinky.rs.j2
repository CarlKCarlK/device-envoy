led_strip! {
    SosStrip {
        pin: {{ led_pin_ident }},
        len: 1,
{% if blinky_kind == "smart_spi" -%}
        engine: Engine::Spi,
{% endif %}
        max_frames: 20,
    }
}
{% endif %}

#[esp_rtos::main]
async fn main(spawner: Spawner) -> ! {
    let err = inner_main(spawner).await.unwrap_err();
    panic!("{err:?}");
}

async fn inner_main(spawner: Spawner) -> Result<Infallible> {
{% if blinky_kind == "smart_rmt" -%}
    init_and_start!(p, rmt80: rmt80, mode: rmt_mode::Blocking);
{% else -%}
    init_and_start!(p);
{% endif %}

    esp_println::logger::init_logger(log::LevelFilter::Info);
{% if blinky_kind == "plain" -%}
    info!("SOS plain LED blinky starting on GPIO{{ led_pin_num }} ({{ board_slug }})");
{% elif blinky_kind == "smart_rmt" -%}
    info!("SOS smart LED blinky (RMT) starting on GPIO{{ led_pin_num }} ({{ board_slug }})");
{% else -%}
    info!("SOS smart LED blinky (SPI) starting on GPIO{{ led_pin_num }} ({{ board_slug }})");
{% endif %}

{% if blinky_kind == "plain" -%}
    let sos_led = SosLed::new(p.{{ led_pin_ident }}, LED_ON_LEVEL, spawner)?;
    sos_led.animate(SOS);
{% elif blinky_kind == "smart_rmt" -%}
    let sos_strip = SosStrip::new(p.{{ led_pin_ident }}, rmt80.channel0, spawner)?;
    sos_strip.animate(&SOS);
{% else -%}
    let sos_strip = SosStrip::new(p.{{ led_pin_ident }}, p.SPI2, spawner)?;
    sos_strip.animate(&SOS);
{% endif %}

    core::future::pending().await
}
