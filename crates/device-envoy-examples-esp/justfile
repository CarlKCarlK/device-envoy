set shell := ["bash", "-cu"]

# ESP docs only
update-docs-esp:
    ../device-envoy-esp/scripts/update-docs.sh

# Incomplete ESP docs preview: uses existing images but skips regeneration and validation
update-docs-esp-unvalidated:
    @echo "WARNING: doc images are not regenerated and validation is skipped; generated ESP docs are not authoritative." >&2
    source "$HOME/export-esp.sh" && cargo doc --manifest-path ../device-envoy-esp/Cargo.toml --no-deps --release --target riscv32imac-unknown-none-elf --features doc-images,esp32c6 --no-default-features

# Build docs and open them in a browser
show-docs-esp:
    just update-docs-esp
    ../device-envoy-esp/scripts/open-docs-esp.sh

# Regenerate board-specific ESP examples from their templates.
generate-board-examples:
    cargo run --manifest-path xtask/Cargo.toml -- generate-board-examples

# Verify board-specific examples are current with their templates.
check-board-examples:
    cargo run --manifest-path xtask/Cargo.toml -- check-board-examples

attach-esp:
    source "$HOME/export-esp.sh" && espflash monitor

run name chip="" port="": generate-board-examples
    ../device-envoy-esp/scripts/device-action.sh run "{{name}}" "{{chip}}" "{{port}}" "{{invocation_directory()}}"

check name chip="": generate-board-examples
    ../device-envoy-esp/scripts/device-action.sh check "{{name}}" "{{chip}}" "" "{{invocation_directory()}}"

build name chip="": generate-board-examples
    ../device-envoy-esp/scripts/device-action.sh build "{{name}}" "{{chip}}" "" "{{invocation_directory()}}"
